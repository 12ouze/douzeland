---
// Page d'accueil : carrousel (photos in_slider) en hero s'il y en a, puis
// le masthead « DOUZE LAND » (toujours affiché, comme une page de titre)
// au-dessus de la galerie verticale de TOUTES les photos.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Slider from '../components/Slider.astro';
import PhotoCard from '../components/PhotoCard.astro';
import { getCollection } from 'astro:content';

// Tri commun : champ `order` décroissant (plus grand = en haut), départage
// stable par id.
const parOrdreDesc = (a, b) =>
  b.data.order - a.data.order || (a.id < b.id ? -1 : 1);

const toutes = await getCollection('photos');
const sliderPhotos = toutes.filter((p) => p.data.in_slider).sort(parOrdreDesc);
const listPhotos = [...toutes].sort(parOrdreDesc);
---

<Layout title="douze land — photographies">
  {sliderPhotos.length > 0 && (
    <div class="slider-overlay-wrapper">
      <Slider photos={sliderPhotos} />
      <!-- Cartouches en overlay sur le slider (desktop seulement).
           Le Header complet en flow reste affiché en dessous (page de titre). -->
      <div class="cart cart-gauche">
        <span class="titre">DOUZE LAND</span>
        <span class="tagline">memoire vive</span>
      </div>
      <div class="cart cart-droite">
        <a href="/archives">archives</a>
        <span class="separateur" aria-hidden="true">|</span>
        <a href="/contact">contact</a>
      </div>
    </div>
  )}
  <Header />
  <main class="galerie">
    {listPhotos.map((photo) => <PhotoCard photo={photo} />)}
  </main>
</Layout>

<style>
  /* Liste verticale : 1 colonne centrée, grandes images, beaucoup d'air. */
  .galerie {
    max-width: var(--max-contenu);
    margin: 0 auto;
    padding: 0 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 6rem; /* ~96px d'air entre les photos */
  }

  /* Wrapper du slider : ancrage absolute pour les 2 cartouches d'overlay.
     Slider.astro est intouché ; tout l'overlay vit ici. */
  .slider-overlay-wrapper {
    position: relative;
  }

  /* Base commune aux 2 cartouches : rectangles noirs au coin haut du slider.
     pointer-events: auto explicite pour rester cliquable (au cas où). */
  .cart {
    position: absolute;
    top: 2rem;
    z-index: 10;
    background: var(--noir);
    color: var(--creme);
    padding: 1rem 1.5rem;
    pointer-events: auto;
  }

  /* Cartouche gauche : identité, typo strictement identique au masthead. */
  .cart-gauche {
    left: 2rem;
    display: flex;
    flex-direction: column;
  }
  .cart-gauche .titre {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    line-height: 1;
  }
  .cart-gauche .tagline {
    margin-top: 0.8rem;
    opacity: 0.55;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }

  /* Cartouche droite : 2 liens (aucun "actuel" puisqu'on est sur /).
     Pas d'underline, pas de gras, pas de transition. */
  .cart-droite {
    right: 2rem;
    display: flex;
    gap: 1rem;
  }
  .cart-droite a {
    color: var(--creme);
    text-decoration: none;
    font-size: 0.85rem;
    text-transform: lowercase;
    letter-spacing: 0.12em;
    opacity: 1;
  }
  .cart-droite a:hover { opacity: 0.7; }

  /* Séparateur visuel entre les 2 liens, non cliquable, opacité réduite. */
  .cart-droite .separateur {
    color: var(--creme);
    font-size: 0.85rem;
    opacity: 0.4;
    pointer-events: none;
  }

  /* Masque l'overlay masthead INTERNE du Slider (.masthead-overlay vit
     dans Slider.astro, qui reste intouché). :global() permet à ce sélecteur
     scopé d'atteindre une classe d'un autre composant. Sans ça, l'overlay
     blanc + mix-blend-mode du slider débordait derrière la cart-gauche. */
  .slider-overlay-wrapper :global(.masthead-overlay) {
    display: none;
  }

  /* Chevron scroll : transformé en cartouche noire cohérente avec les
     autres overlays. Slider.astro intouché ; override via :global().
     !important nécessaire pour neutraliser la pulse animation (qui anime
     aussi le transform) et la classe .cache ajoutée par le JS du Slider
     au scroll > 50px (qui mettrait opacity: 0). */
  .slider-overlay-wrapper :global(.chevron) {
    background: var(--noir);
    color: var(--creme);
    display: flex;
    align-items: center;
    justify-content: center;
    /* Padding asymétrique : le glyphe ⌄ (U+2304) est dessiné dans la
       partie haute du cadran de texte de la fonte → il apparaît collé
       au bas du rectangle. On compense avec padding-bottom > padding-top
       pour le pousser vers le haut. Hauteur totale ~2.2rem. */
    padding: 0rem 0.9rem 0.8rem;
    font-size: 1.7rem;
    line-height: 1;
    text-shadow: none;
    animation: none !important;
    transform: translateX(-50%) !important;
    opacity: 1 !important;
  }

  /* Mobile (≤600px) : Slider.astro se met en display:none → on cache aussi
     les cartouches pour qu'elles ne flottent pas par-dessus le Header en flow. */
  @media (max-width: 600px) {
    .cart { display: none; }
  }
</style>
