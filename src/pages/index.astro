---
// Page d'accueil : carrousel (photos in_slider) en hero s'il y en a, puis
// le masthead « DOUZE LAND » (toujours affiché, comme une page de titre)
// au-dessus de la galerie verticale de TOUTES les photos.
import Layout from '../layouts/Layout.astro';
import IntroGlitch from '../components/IntroGlitch.astro';
import Header from '../components/Header.astro';
import Slider from '../components/Slider.astro';
import PhotoCard from '../components/PhotoCard.astro';
import { getCollection } from 'astro:content';

// Tri commun : champ `order` décroissant (plus grand = en haut), départage
// stable par id.
const parOrdreDesc = (a, b) =>
  b.data.order - a.data.order || (a.id < b.id ? -1 : 1);

const toutes = await getCollection('photos');
const sliderPhotos = toutes.filter((p) => p.data.in_slider).sort(parOrdreDesc);
const listPhotos = [...toutes].sort(parOrdreDesc);
---

<Layout title="douze land — photographies">
  <IntroGlitch />
  {sliderPhotos.length > 0 && (
    <div class="slider-overlay-wrapper">
      <Slider photos={sliderPhotos} />
    </div>
  )}
  <Header />
  <main class="galerie">
    {listPhotos.map((photo) => <PhotoCard photo={photo} />)}
  </main>
</Layout>

<script>
  // Cartouche flèche scroll : clic (ou Entrée/Espace) → smooth scroll d'un
  // viewport (100dvh) vers le bas, soit pile le début de la galerie sous le
  // slider. Le glyphe .chevron vit dans Slider.astro (intouché, aria-hidden) ;
  // on l'enrichit ici au runtime en vrai bouton accessible. Si pas de slider
  // (aucune photo featured), .chevron est absent → le bloc est inerte.
  const fleche = document.querySelector('.chevron');
  if (fleche) {
    fleche.setAttribute('role', 'button');
    fleche.setAttribute('tabindex', '0');
    fleche.setAttribute('aria-label', 'Aller à la galerie');
    fleche.removeAttribute('aria-hidden');
    const scroller = () => window.scrollBy({ top: window.innerHeight, behavior: 'smooth' });
    fleche.addEventListener('click', scroller);
    fleche.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        scroller();
      }
    });
  }
</script>

<style>
  /* Liste verticale : 1 colonne centrée, grandes images, beaucoup d'air. */
  .galerie {
    max-width: var(--max-contenu);
    margin: 0 auto;
    padding: 0 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 6rem; /* ~96px d'air entre les photos */
  }

  /* Wrapper du slider : conteneur des overrides :global() ciblant les
     éléments internes du Slider (masthead, points, chevron).
     Slider.astro est intouché ; tout l'overlay vit ici. */
  .slider-overlay-wrapper {
    position: relative;
  }

  /* Masque l'overlay masthead INTERNE du Slider (.masthead-overlay vit
     dans Slider.astro, qui reste intouché). :global() permet à ce sélecteur
     scopé d'atteindre une classe d'un autre composant. Sans ça, l'overlay
     blanc + mix-blend-mode du slider débordait derrière la cart-gauche. */
  .slider-overlay-wrapper :global(.masthead-overlay) {
    display: none;
  }

  /* Masque les points de pagination du slider : redondants avec les flèches
     + l'autoplay + la cartouche chevron, et trop "carrousel marketing" pour
     le style éditorial. Slider.astro intouché ; le markup des points reste en
     place (.points), on les cache via :global(). Pas de saut de layout : .points
     est position: absolute, donc hors flux (le chevron, lui aussi absolute,
     ne bouge pas). Pour les remettre un jour : supprimer cette règle. */
  .slider-overlay-wrapper :global(.points) {
    display: none;
  }

  /* Chevron scroll : flèche blanche lisible, alignée sur le traitement des
     flèches latérales ‹ › du slider (#fff + text-shadow) → reste lisible sur
     photo claire comme sombre. Légère respiration verticale. Slider.astro
     intouché ; override via :global().
     - animation ... !important : neutralise la pulse d'origine (chevron-pulse)
       ET la classe .cache posée par le JS du Slider au scroll (qui mettrait
       animation: none). Le centrage horizontal est porté PAR les keyframes
       (translate(-50%, …)), donc pas de transform statique ici : un transform
       !important gagnerait sur l'animation et tuerait le flottement.
     - opacity: 1 !important : neutralise l'opacity: 0 de .cache → le chevron
       reste visible (comportement inchangé). */
  .slider-overlay-wrapper :global(.chevron) {
    color: #fff;
    font-size: 2.2rem; /* ~+29% vs 1.7rem, reste éditorial */
    line-height: 1;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5); /* même valeur que .fleche */
    opacity: 1 !important;
    animation: chevron-flottement 2s ease-in-out infinite alternate !important;
    /* La cartouche est décorative dans Slider.astro (pointer-events: none).
       On la rend cliquable ici : le smooth scroll est ajouté par le <script>
       ci-dessus. */
    pointer-events: auto;
    cursor: pointer;
  }

  /* Respiration verticale douce : remonte le chevron de 12px (loin du bord bas)
     puis oscille entre -12px et -19px → il monte puis redescend. translate(-50%,
     …) conserve le centrage horizontal (left: 50% dans Slider.astro).
     alternate → va-et-vient sans à-coup. */
  @keyframes chevron-flottement {
    from { transform: translate(-50%, -12px); }
    to   { transform: translate(-50%, -19px); }
  }

  /* Accessibilité : coupe la respiration si l'utilisateur a réduit les
     animations. Le chevron reprend alors le transform de centrage de
     Slider.astro (translateX(-50%)), donc reste centré. */
  @media (prefers-reduced-motion: reduce) {
    .slider-overlay-wrapper :global(.chevron) {
      animation: none !important;
      transform: translate(-50%, -12px) !important;
    }
  }
</style>
