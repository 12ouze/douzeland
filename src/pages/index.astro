---
// Page d'accueil : carrousel (photos in_slider) en hero s'il y en a, puis
// le masthead « DOUZE LAND » (toujours affiché, comme une page de titre)
// au-dessus de la galerie verticale de TOUTES les photos.
import Layout from '../layouts/Layout.astro';
import IntroGlitch from '../components/IntroGlitch.astro';
import Header from '../components/Header.astro';
import Slider from '../components/Slider.astro';
import PhotoCard from '../components/PhotoCard.astro';
import { getCollection } from 'astro:content';

// Tri commun : champ `order` décroissant (plus grand = en haut), départage
// stable par id.
const parOrdreDesc = (a, b) =>
  b.data.order - a.data.order || (a.id < b.id ? -1 : 1);

const toutes = await getCollection('photos');
const sliderPhotos = toutes.filter((p) => p.data.in_slider).sort(parOrdreDesc);
const listPhotos = [...toutes].sort(parOrdreDesc);
---

<Layout
  title="douze land — photographies"
  description="douze land, le carnet photographique de Douze — memoire vive. Ses photographies publiées au fil de l'eau, plein cadre, dans un esprit magazine."
>
  <IntroGlitch />
  {sliderPhotos.length > 0 && (
    <div class="slider-overlay-wrapper">
      <Slider photos={sliderPhotos} />
      {/* Signature de couverture : le nom du site en petit, haut-centre du
          hero. Classe .signature et NON .masthead-overlay — cette dernière est
          masquée juste en dessous (overlay interne du Slider) ; réutiliser le
          nom rendrait la signature invisible.
          aria-hidden : le vrai masthead (lien, cliquable) est le <Header /> qui
          suit immédiatement dans le DOM → sans ça, un lecteur d'écran
          annoncerait « DOUZE LAND » deux fois de suite. */}
      <p class="signature" aria-hidden="true">DOUZE LAND</p>
      {/* Indice de scroll (texte) : nombre de photos RÉELLEMENT listées plus
          bas (listPhotos, la source de la galerie) → le chiffre annoncé et ce
          que le visiteur trouve en scrollant ne peuvent pas diverger. */}
      <p class="compteur">
        {listPhotos.length} photographie{listPhotos.length > 1 ? 's' : ''}
      </p>
    </div>
  )}
  <Header titreEnH1 />
  <main class="galerie">
    {/* priorite sur la 1re photo seulement : c'est la première image visible
        (le slider est masqué ≤600px) → eager + fetchpriority=high pour ne pas
        retarder le premier écran. Les suivantes restent en lazy. */}
    {listPhotos.map((photo, i) => <PhotoCard photo={photo} priorite={i === 0} />)}
  </main>
</Layout>

<script>
  // Cartouche flèche scroll : clic (ou Entrée/Espace) → smooth scroll d'un
  // viewport (100dvh) vers le bas, soit pile le début de la galerie sous le
  // slider. Le glyphe .chevron vit dans Slider.astro (intouché, aria-hidden) ;
  // on l'enrichit ici au runtime en vrai bouton accessible. Si pas de slider
  // (aucune photo featured), .chevron est absent → le bloc est inerte.
  const fleche = document.querySelector('.chevron');
  const hero = document.querySelector('.slider-overlay-wrapper');
  if (fleche && hero) {
    fleche.setAttribute('role', 'button');
    fleche.setAttribute('tabindex', '0');
    fleche.setAttribute('aria-label', 'Aller à la galerie');
    fleche.removeAttribute('aria-hidden');
    // Destination = bas réel du hero, mesuré à chaque clic sur l'élément
    // lui-même (jamais une constante). Le hero étant le 1er élément du flux
    // (l'intro est en position: fixed), son bord bas en coordonnées document
    // vaut rect.bottom + scrollY → le header crème arrive pile en haut du
    // viewport. Dérivé de l'élément, donc juste tout seul si la hauteur du
    // hero rechange (calc(100dvh - 4rem) aujourd'hui) ou si on redimensionne.
    const scroller = () =>
      window.scrollTo({
        top: hero.getBoundingClientRect().bottom + window.scrollY,
        behavior: 'smooth',
      });
    fleche.addEventListener('click', scroller);
    fleche.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        scroller();
      }
    });
  }
</script>

<style>
  /* Liste verticale : 1 colonne centrée, grandes images, beaucoup d'air. */
  .galerie {
    max-width: var(--max-contenu);
    margin: 0 auto;
    padding: 0 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 6rem; /* ~96px d'air entre les photos */
  }

  /* Wrapper du slider : conteneur des overrides :global() ciblant les
     éléments internes du Slider (masthead, points, chevron).
     Slider.astro est intouché ; tout l'overlay vit ici. */
  .slider-overlay-wrapper {
    position: relative;
  }

  /* INDICE DE SCROLL (1/2) : on raccourcit le hero pour laisser dépasser une
     bande de la section crème qui suit → contraste franc sous une photo plein
     cadre, on comprend qu'il y a du contenu en dessous. Slider.astro (100dvh)
     est intouché ; override via :global().

     Pourquoi 2.5rem FIXE et pas un pourcentage : la crème disponible avant le
     titre « DOUZE LAND » est le padding-top du Header, soit 5rem = 80px — une
     valeur FIXE, identique sur tous les écrans. Une bande en vh, elle, grandit
     avec le viewport : 8vh = 64px sur un portable (OK) mais 104px sur un 1440p
     → le masthead serait rogné de 24px. calc() garantit une bande de 40px
     partout, donc 40px de marge avant le titre : jamais de titre coupé.
     Le fallback vh reste obligatoire (cf. CLAUDE.md → viewport sans scroll). */
  .slider-overlay-wrapper :global(.slider) {
    height: calc(100vh - 2.5rem);  /* fallback */
    height: calc(100dvh - 2.5rem);
  }

  /* MASTHEAD DE COUVERTURE : « DOUZE LAND » en haut à gauche du hero, sur le
     même axe vertical que le masthead de la bande crème (cf. ALIGNEMENT plus
     bas) — tout le site étant aligné à gauche, un titre centré détonnait.
     4 des 5 propriétés typographiques sont RECOPIÉES à l'identique de
     Header.astro → .titre (font-weight 800, uppercase,
     clamp(1.6rem, 4vw, 2.6rem), line-height 1). Elles sont dupliquées, pas
     partagées : si tu changes la typo du Header un jour, il faut la répercuter
     ICI aussi (les styles Astro étant scopés, aucun moyen d'hériter sans
     variable globale).

     LETTER-SPACING : 0.10em ICI, 0.22em dans Header.astro → .titre.
     ⚠️ CE N'EST PAS UN OUBLI DE SYNCHRONISATION — ne pas « corriger » en
     recopiant 0.22em. C'est une compensation optique liée au fond.
     Sur la bande crème du Header, le texte noir se détache sur un aplat
     uniforme : l'approche ample aère et se lit comme une intention éditoriale.
     Ici, le texte blanc est posé sur une photo — grain, contrastes locaux et
     text-shadow viennent remplir les blancs entre les lettres, qui cessent
     d'être perçus comme de l'espace et se lisent comme de la dispersion : le
     mot se délite au lieu de tenir en bloc. Resserrer lui rend sa cohésion.
     La valeur est descendue en deux passes (0.22 → 0.15 → 0.10) : 0.15em
     corrigeait déjà, mais pas assez pour que le mot tienne en bloc.
     PLANCHER : ~0.06em. En capitales, en dessous, les lettres se collent et
     l'ensemble redevient illisible sur un fond chargé — on aurait remplacé un
     défaut par l'autre. On est proche de la limite, ne pas continuer à
     descendre sans regarder le rendu sur une photo claire ET une photo dense.
     Conséquence assumée : le masthead du hero est désormais ~1.2em plus
     ÉTROIT que celui de la bande crème (l'approche s'ajoute après chacun des
     10 caractères). Au scroll, les deux mastheads n'ont donc plus la même
     largeur — ça s'ajoute au décalage horizontal déjà assumé plus bas.
     Ombre renforcée (0 2px 12px / 0.6) vs celle du chevron : à cette taille le
     texte couvre beaucoup de surface, donc beaucoup plus de risques de tomber
     sur une zone claire ou chargée.
     Pas d'animation (ce n'est pas un indice de scroll, il n'a pas à flotter
     avec le chevron) et pas de baseline « memoire vive », qui reste au masthead
     du dessous. Non cliquable : on est déjà sur la home.

     ALIGNEMENT SUR LA PHOTO (et non sur la grille du site) : marges égales de
     2.5rem depuis le haut et depuis le bord gauche du hero. Le titre se cale
     donc sur le cadre de l'image, pas sur le conteneur max-width: 1000px du
     Header — au scroll, il y a un décalage horizontal avec le masthead crème,
     c'est assumé.
     À savoir : ce n'est PAS la marge des flèches du slider. Dans Slider.astro,
     .fleche-prec est à left: 0.5rem avec padding: 0.4rem 0.8rem → le glyphe ‹
     démarre vers 1.3rem (~21px), soit à peu près la moitié d'ici. Le chevron,
     lui, est centré (left: 50%) : il n'a pas de marge gauche du tout. */
  .signature {
    position: absolute;
    top: 2.5rem;
    left: 2.5rem;
    z-index: 4; /* même palier que le compteur */
    margin: 0;
    color: #fff;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.10em; /* ≠ 0.22em du Header : voir « LETTER-SPACING » ci-dessus */
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    line-height: 1;
    opacity: 1;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
    white-space: nowrap;
    pointer-events: none;
  }

  /* INDICE DE SCROLL (2/2) : « N photographies » juste au-dessus du chevron.
     Même traitement que le chevron (#fff + text-shadow) → lisible sur photo
     claire comme sombre. Hors de .slider (qui est overflow: hidden), donc non
     rogné ; positionné dans le wrapper, qui partage le même bord bas.
     bottom: 2.3rem : le texte se cale juste au-dessus du glyphe ⌄. La valeur
     mord sur la *boîte* du chevron (bottom: 1rem + 2.2rem de line-box), mais
     pas sur son encre : le glyphe ⌄ n'occupe que le bas de sa line-box, donc
     l'espace visuel restant est d'environ 10px. Les deux se lisent comme un
     bloc. Écart CONSTANT pendant l'animation : le compteur et le chevron
     partagent la même animation (même amplitude, même phase), donc la distance
     entre eux ne varie jamais — c'est le décalage qui bougeait, pas l'écart. */
  .compteur {
    position: absolute;
    bottom: 2.3rem;
    left: 50%;
    z-index: 4; /* au-dessus du chevron (3), même palier "navigation" */
    margin: 0;
    color: #fff;
    font-size: 0.85rem;
    /* Ample, et volontairement conservé à 0.22em alors que .signature est
       redescendu à 0.10em : ces deux valeurs ne sont PAS liées, ne pas les
       resynchroniser. À 0.85rem, l'approche large sépare les lettres au lieu
       de les disperser — c'est ce qui tient le texte lisible sur photo à cette
       taille. Le problème de dispersion ne se pose qu'en grand corps. */
    letter-spacing: 0.22em;
    text-transform: lowercase;
    opacity: 0.9; /* 0.75 était trop pâle sur une photo claire */
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5); /* même valeur que le chevron */
    white-space: nowrap;
    /* Flotte avec le chevron plutôt que de rester fixe : le chevron oscille sur
       7px, donc un texte statique verrait l'écart entre eux "pomper" de 13px à
       6px en boucle. Même animation = écart constant, les deux se lisent comme
       un seul bloc. Pour le figer : supprimer cette ligne (le centrage est alors
       repris par la règle prefers-reduced-motion ci-dessous, à dupliquer ici). */
    animation: chevron-flottement 2s ease-in-out infinite alternate;
  }

  /* Mobile (≤600px) : Slider.astro masque .slider (display: none) → le wrapper
     retombe à 0 de haut. Sans cette règle, les overlays (absolute) iraient se
     poser en blanc sur la crème du Header, illisibles. On les masque avec le
     hero : ils n'ont de sens que quand il y a un hero. */
  @media (max-width: 600px) {
    .compteur,
    .signature {
      display: none;
    }
    /* Rythme d'entrée mobile resserré (variables lues par Header.astro) :
       3.5rem au-dessus du masthead (au lieu de 5rem), et 1.5rem entre la nav
       et la 1re photo — la MÊME valeur que le gap tagline → nav du Header :
       les trois écarts internes du header (titre → tagline, visuellement
       ~24px ; tagline → nav, 24px ; nav → photo, 24px) forment une cadence
       régulière, la nav ne « flotte » plus entre deux zones. Bonus : la
       première photo (portrait ~491px) remonte à ~679px de bas dans les
       ~660px utiles d'un iPhone. Mêmes valeurs posées sur /archives ;
       /contact garde les fallbacks du Header. Cette feuille n'étant chargée
       que sur la home, le :root ne fuit pas ailleurs. */
    :global(:root) {
      --masthead-haut-mobile: 3.5rem;
      --masthead-bas-mobile: 1.5rem;
    }
  }

  /* Masque l'overlay masthead INTERNE du Slider (.masthead-overlay vit
     dans Slider.astro, qui reste intouché). :global() permet à ce sélecteur
     scopé d'atteindre une classe d'un autre composant. Sans ça, l'overlay
     blanc + mix-blend-mode du slider débordait derrière la cart-gauche. */
  .slider-overlay-wrapper :global(.masthead-overlay) {
    display: none;
  }

  /* Masque les points de pagination du slider : redondants avec les flèches
     + l'autoplay + la cartouche chevron, et trop "carrousel marketing" pour
     le style éditorial. Slider.astro intouché ; le markup des points reste en
     place (.points), on les cache via :global(). Pas de saut de layout : .points
     est position: absolute, donc hors flux (le chevron, lui aussi absolute,
     ne bouge pas). Pour les remettre un jour : supprimer cette règle. */
  .slider-overlay-wrapper :global(.points) {
    display: none;
  }

  /* Chevron scroll : flèche blanche lisible, alignée sur le traitement des
     flèches latérales ‹ › du slider (#fff + text-shadow) → reste lisible sur
     photo claire comme sombre. Légère respiration verticale. Slider.astro
     intouché ; override via :global().
     - animation ... !important : neutralise la pulse d'origine (chevron-pulse)
       ET la classe .cache posée par le JS du Slider au scroll (qui mettrait
       animation: none). Le centrage horizontal est porté PAR les keyframes
       (translate(-50%, …)), donc pas de transform statique ici : un transform
       !important gagnerait sur l'animation et tuerait le flottement.
     - opacity: 1 !important : neutralise l'opacity: 0 de .cache → le chevron
       reste visible (comportement inchangé). */
  .slider-overlay-wrapper :global(.chevron) {
    color: #fff;
    font-size: 2.2rem; /* ~+29% vs 1.7rem, reste éditorial */
    line-height: 1;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5); /* même valeur que .fleche */
    opacity: 1 !important;
    animation: chevron-flottement 2s ease-in-out infinite alternate !important;
    /* La cartouche est décorative dans Slider.astro (pointer-events: none).
       On la rend cliquable ici : le smooth scroll est ajouté par le <script>
       ci-dessus. */
    pointer-events: auto;
    cursor: pointer;
  }

  /* Respiration verticale douce : remonte le chevron de 12px (loin du bord bas)
     puis oscille entre -12px et -19px → il monte puis redescend. translate(-50%,
     …) conserve le centrage horizontal (left: 50% dans Slider.astro).
     alternate → va-et-vient sans à-coup. */
  @keyframes chevron-flottement {
    from { transform: translate(-50%, -12px); }
    to   { transform: translate(-50%, -19px); }
  }

  /* Accessibilité : coupe la respiration si l'utilisateur a réduit les
     animations. Le chevron reprend alors le transform de centrage de
     Slider.astro (translateX(-50%)), donc reste centré. */
  @media (prefers-reduced-motion: reduce) {
    .slider-overlay-wrapper :global(.chevron),
    .compteur {
      animation: none !important;
      transform: translate(-50%, -12px) !important;
    }
  }
</style>
