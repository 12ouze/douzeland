---
// Page individuelle d'une photo : /photo/<slug>
// Une route par photo, générée au build via getStaticPaths().
// Esprit brutaliste : photo entièrement visible (object-fit: contain),
// centrée, bandes crème automatiques selon le ratio. Aucune métadonnée
// visible, un seul élément d'interface (lien « retour »).
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import '../../styles/global.css';

// Une page par entrée de la collection. L'id de l'entrée (nom du .md sans
// extension, ex. « 2025-09-balade ») devient le slug de l'URL.
export async function getStaticPaths() {
  const photos = await getCollection('photos');
  return photos.map((photo) => ({
    params: { slug: photo.id },
    props: { photo },
  }));
}

const { photo } = Astro.props;
const { image, alt, title } = photo.data;

// Métadonnées de partage/SEO — ⚠️ ce <head> est INDÉPENDANT de Layout.astro
// (dette documentée dans CLAUDE.md) : toute évolution des métadonnées
// communes doit être faite ICI ET dans Layout.astro.
// Description construite depuis le titre et l'alt de la photo.
const description = title
  ? `${title} — ${alt}. Une photographie du carnet douze land.`
  : `${alt}. Une photographie du carnet douze land.`;
const titrePage = `${title ?? 'douze land'} — douze land`;
// og:image = LA photo de la page, en ~1200px, jpeg (iMessage et certains
// crawlers de messageries ne décodent pas le webp dans les aperçus).
const imageOg = await getImage({ src: image, width: 1200, format: 'jpeg' });
const urlCanonique = new URL(`/photo/${photo.id}/`, Astro.site);
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{titrePage}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonique} />
    <meta property="og:title" content={titrePage} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="douze land" />
    <meta property="og:image" content={new URL(imageOg.src, Astro.site)} />
    <meta property="og:image:width" content={String(imageOg.attributes.width)} />
    <meta property="og:image:height" content={String(imageOg.attributes.height)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {/* H1 masqué visuellement : la page est la photo plein écran, aucun
        texte visible n'est prévu, mais chaque page doit avoir son H1. */}
    <h1 class="visuellement-cache">{title ?? alt}</h1>
    <a class="retour" href="/">← retour</a>
    <Image
      class="photo"
      src={image}
      alt={alt}
      widths={[640, 960, 1280, 1920, 2400]}
      sizes="100vw"
      format="webp"
    />
  </body>
</html>

<style>
  /* Fond crème depuis la variable globale (src/styles/global.css). C'est
     ce crème qu'on voit dans les bandes autour de la photo. */
  body {
    margin: 0;
    height: 100vh;        /* fallback pour les vieux navigateurs */
    height: 100dvh;       /* hauteur réelle du viewport (barres mobiles) */
    overflow: hidden;     /* zéro scroll, ni vertical ni horizontal */
    background: var(--creme);
  }

  /* La photo occupe tout le viewport puis object-fit: contain l'y inscrit
     en entier (ratio préservé, jamais croppée). La surface non couverte
     laisse voir le fond crème → bandes automatiques : haut/bas pour un
     paysage, gauche/droite pour un portrait. Centrée (object-position
     center par défaut). */
  .photo {
    display: block;
    width: 100vw;
    height: 100vh;        /* fallback */
    height: 100dvh;
    object-fit: contain;
  }

  /* Lien « retour » : fixe, haut-gauche, persistant au scroll. Petit bloc
     crème (bords vifs = brutaliste) pour garantir le contraste sur
     n'importe quelle zone de la photo, sans ornement. Cible tactile >= 44px.
     env(safe-area-inset-*) décale sous les encoches mobiles. */
  .retour {
    position: fixed;
    z-index: 10;          /* passe devant la photo */
    top: calc(1.5rem + env(safe-area-inset-top, 0px));
    left: calc(1.5rem + env(safe-area-inset-left, 0px));
    padding: 0.6rem 0.9rem;
    background: var(--creme);
    color: var(--noir);
    text-decoration: none;
    font: 600 0.85rem/1 system-ui, 'Helvetica Neue', Arial, sans-serif;
    letter-spacing: 0.04em;
  }
</style>
