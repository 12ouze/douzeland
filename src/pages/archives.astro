---
// Page /archives : grille 4 colonnes de TOUTES les photos publiées.
// Tri identique à la home : `order` décroissant, départage stable par id.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const parOrdreDesc = (a, b) =>
  b.data.order - a.data.order || (a.id < b.id ? -1 : 1);

const photos = (await getCollection('photos')).sort(parOrdreDesc);
---

<Layout title="archives — douze land">
  <Header />
  {photos.length === 0 ? (
    <main class="archives vide">
      <p>aucune archive pour le moment</p>
    </main>
  ) : (
    <main class="archives">
      {photos.map((photo) => (
        <a class="vignette" href={`/photo/${photo.id}`}>
          {/* `sizes` DOIT refléter la grille CSS ci-dessous (colonnes par
              palier) : ≤600px → 3 colonnes ≈ 30vw ; ≤900px → 2 colonnes
              ≈ 50vw ; desktop → 4 colonnes dans le conteneur 1000px ≈ 226px,
              déclaré 250px (léger arrondi haut, sans conséquence). Une valeur
              trop large (ex. 100vw) ferait télécharger des fichiers énormes
              pour des vignettes minuscules. */}
          <Image
            src={photo.data.image}
            alt={photo.data.alt}
            widths={[240, 400, 640, 960]}
            sizes="(max-width: 600px) 30vw, (max-width: 900px) 50vw, 250px"
            format="webp"
            loading="lazy"
          />
        </a>
      ))}
    </main>
  )}
</Layout>

<style>
  /* Grille dense en carrés 1:1 : uniforme malgré les ratios mixtes
     (paysage + portrait). Crop assumé sur les vignettes ; le détail
     /photo/[slug] reste en contain sans aucun crop. */
  .archives {
    max-width: var(--max-contenu);
    margin: 0 auto;
    padding: 2rem 1.5rem 1.5rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  @media (max-width: 900px) {
    .archives { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .archives {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.3rem;
    }
  }

  .vignette {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    transition: opacity 0.2s ease;
  }
  .vignette:hover { opacity: 0.85; } /* fade discret au hover desktop */
  .vignette img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* État vide : message discret centré, pas de grille. */
  .archives.vide {
    display: block;
    text-align: center;
    color: var(--noir);
    opacity: 0.5;
    font-size: 0.95rem;
    padding-top: 4rem;
  }
  .archives.vide p { margin: 0; }
</style>
