---
// Carrousel hero (photos in_slider). Tri (order desc) fait par index.astro.
// Boucle infinie FLUIDE via clones : on duplique la dernière slide avant la
// première et la première après la dernière. On démarre sur la vraie 1re
// slide (DOM index 1). Animation 'smooth' partout ; quand le scroll s'arrête
// sur un clone, téléportation invisible ('auto') vers la vraie slide
// équivalente (clone = image identique → saut imperceptible).
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  photos: CollectionEntry<'photos'>[];
}

const { photos } = Astro.props;
const n = photos.length;
const multiple = n > 1;
// DOM : [clone(dernière), ...vraies, clone(première)] si plusieurs photos.
const slidesDom = multiple ? [photos[n - 1], ...photos, photos[0]] : photos;
---

<section class="slider">
  <!-- Masthead en overlay (remplace le Header quand le slider est affiché) -->
  <div class="masthead-overlay">
    <span class="titre">DOUZE LAND</span>
    <span class="tagline">memoire vive</span>
  </div>

  <!-- Piste scroll-snap horizontale (clones aux extrémités pour la boucle) -->
  <div class="piste" id="slider-piste" data-count={n}>
    {slidesDom.map((photo, domPos) => {
      const estClone = multiple && (domPos === 0 || domPos === slidesDom.length - 1);
      const premiereVisible = multiple ? domPos === 1 : domPos === 0;
      return (
        <div class="slide" data-clone={estClone ? 'true' : undefined} aria-hidden={estClone ? 'true' : undefined}>
          <Image
            class="slide-img"
            src={photo.data.image}
            alt={photo.data.alt}
            widths={[640, 960, 1280, 1920, 2400]}
            sizes="100vw"
            format="webp"
            loading={premiereVisible ? 'eager' : 'lazy'}
          />
        </div>
      );
    })}
  </div>

  <!-- Anti-flash : positionne sur la 1re vraie slide avant le 1er paint -->
  <script is:inline>
    (function () {
      var p = document.getElementById('slider-piste');
      if (p && p.children.length > 1) p.scrollLeft = p.clientWidth;
    })();
  </script>

  {multiple && (
    <Fragment>
      <button class="fleche fleche-prec" type="button" aria-label="Photo précédente">‹</button>
      <button class="fleche fleche-suiv" type="button" aria-label="Photo suivante">›</button>
      <div class="points">
        {photos.map((_, i) => (
          <span class:list={['point', { actif: i === 0 }]}></span>
        ))}
      </div>
    </Fragment>
  )}

  <span class="chevron" aria-hidden="true">⌄</span>
</section>

<script>
  const piste = document.getElementById('slider-piste');
  if (piste) {
    const n = Number(piste.dataset.count); // nb de VRAIES photos
    const points = Array.from(document.querySelectorAll<HTMLElement>('.point'));
    const total = piste.querySelectorAll('.slide').length; // n + 2 si clones

    if (n > 1) {
      const section = piste.closest('.slider');
      const largeur = () => piste.clientWidth; // 1 slide = 100% de la piste

      // Position DOM courante (arrondie) et index réel correspondant.
      const domCourant = () => Math.round(piste.scrollLeft / largeur());
      const reel = (dom: number) => (((dom - 1) % n) + n) % n;

      // Démarrer sur la 1re vraie slide (DOM index 1), pas sur le clone.
      // (Doublon de l'init inline, par sécurité ; idempotent.)
      piste.scrollLeft = largeur();

      const majPoints = () => {
        const r = reel(domCourant());
        points.forEach((p, i) => p.classList.toggle('actif', i === r));
      };
      majPoints();

      const goDom = (dom: number, behavior: ScrollBehavior) =>
        piste.scrollTo({ left: dom * largeur(), behavior });

      // 'smooth' pour tous les clics : le wrapping est géré par les clones
      // + la téléportation post-atterrissage (plus de "if dernier → 1").
      const suivant = () => goDom(domCourant() + 1, 'smooth');
      const precedent = () => goDom(domCourant() - 1, 'smooth');

      // Quand le scroll s'arrête sur un clone, téléportation invisible vers
      // la vraie slide équivalente (même image → aucun saut visible).
      const teleporterSiClone = () => {
        const dom = domCourant();
        if (dom === 0) goDom(n, 'auto'); // clone de fin → vraie dernière
        else if (dom === total - 1) goDom(1, 'auto'); // clone de début → vraie première
      };

      // Détection "scroll arrêté" par debounce (couvre clics smooth ET swipe).
      let settle: ReturnType<typeof setTimeout>;
      piste.addEventListener(
        'scroll',
        () => {
          majPoints();
          clearTimeout(settle);
          settle = setTimeout(teleporterSiClone, 120);
        },
        { passive: true },
      );

      // --- Défilement automatique (12 s) ---------------------------------
      // Pause sur interaction (reprise 12 s après la DERNIÈRE) et hors écran.
      // Respecte prefers-reduced-motion (aucun autoplay). L'intervalle (12 s)
      // est très supérieur à la transition+téléportation (~0,5 s) → aucun
      // chevauchement possible avec le wrapping des clones.
      const INTERVALLE = 12000;
      const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let visible = true;
      let autoTimer: ReturnType<typeof setInterval> | null = null;
      let repriseTimer: ReturnType<typeof setTimeout> | null = null;

      const stopAuto = () => {
        if (autoTimer) {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      };
      const startAuto = () => {
        if (reduit) return; // accessibilité : pas d'autoplay
        stopAuto();
        autoTimer = setInterval(suivant, INTERVALLE); // 1er tick à +12 s
      };
      // Toute interaction : pause immédiate, reprise 12 s après la dernière.
      const interaction = () => {
        stopAuto();
        if (repriseTimer) clearTimeout(repriseTimer);
        repriseTimer = setTimeout(() => {
          if (visible) startAuto();
        }, INTERVALLE);
      };

      document.querySelector('.fleche-suiv')?.addEventListener('click', () => {
        suivant();
        interaction();
      });
      document.querySelector('.fleche-prec')?.addEventListener('click', () => {
        precedent();
        interaction();
      });

      // Visibilité (≥50%) : pilote le clavier ET l'autoplay.
      if (section) {
        new IntersectionObserver(
          (entries) => {
            visible = entries[0].isIntersecting;
            if (visible) {
              startAuto(); // reprise immédiate (1er tick à +12 s)
            } else {
              stopAuto(); // pause + cleanup (pas de leak hors écran)
              if (repriseTimer) clearTimeout(repriseTimer);
            }
          },
          { threshold: 0.5 },
        ).observe(section);
      } else {
        startAuto();
      }

      document.addEventListener('keydown', (e) => {
        if (!visible) return;
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          suivant();
          interaction();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          precedent();
          interaction();
        }
      });
    }

    // Chevron : fade out une fois que l'utilisateur a scrollé > 50px.
    const chevron = document.querySelector('.chevron');
    const onScroll = () => chevron?.classList.toggle('cache', window.scrollY > 50);
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .slider {
    position: relative;
    width: 100vw;
    height: 100vh;   /* fallback */
    height: 100dvh;
    overflow: hidden;
  }

  /* Piste scroll-snap horizontale (scrollbar masquée) */
  .piste {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .piste::-webkit-scrollbar { display: none; }

  .slide {
    flex: 0 0 100%;
    width: 100vw;
    height: 100%;
    scroll-snap-align: start;
  }
  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* hero plein cadre, recadrage assumé */
  }

  /* Masthead overlay, haut-gauche, par-dessus la photo */
  .masthead-overlay {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    z-index: 3;
    color: #fff;
    mix-blend-mode: difference;                 /* lisible sur tout fond */
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);  /* fallback contraste */
    pointer-events: none;
  }
  .masthead-overlay .titre {
    display: block;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    line-height: 1;
  }
  .masthead-overlay .tagline {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    opacity: 0.85;
  }

  /* Flèches (desktop seulement) */
  .fleche {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    border: none;
    background: transparent;
    color: #fff;
    font-size: 2.6rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.4rem 0.8rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }
  .fleche-prec { left: 0.5rem; }
  .fleche-suiv { right: 0.5rem; }
  /* Mobile (≤600px) : photo entière en largeur, hauteur = ratio naturel.
     Piste A (height auto) : avec le <Image> Astro (attributs width/height),
     le navigateur réserve déjà le bon ratio → aucun crop, zéro CLS, pas de
     calcul de ratio par slide. */
  @media (max-width: 600px) {
    .fleche { display: none; }

    .slider { height: auto; }
    .piste {
      height: auto;
      align-items: flex-start; /* chaque slide garde sa hauteur naturelle */
    }
    .slide { height: auto; }
    .slide-img { height: auto; } /* plein largeur, ratio naturel, aucun crop */
  }

  /* Points : indicateur de position */
  .points {
    position: absolute;
    bottom: 2.6rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 0.5rem;
  }
  .point {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    opacity: 0.4;
    box-shadow: 0 0 3px rgba(0, 0, 0, 0.4);
    transition: opacity 0.2s;
  }
  .point.actif { opacity: 1; }

  /* Chevron : pulse douce, fade au scroll */
  .chevron {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.8rem;
    line-height: 1;
    pointer-events: none;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
    animation: chevron-pulse 1.6s ease-in-out infinite;
    transition: opacity 0.4s ease;
  }
  .chevron.cache {
    opacity: 0;
    animation: none;
  }
  @keyframes chevron-pulse {
    0%, 100% { opacity: 0.85; transform: translate(-50%, 0); }
    50%      { opacity: 0.45; transform: translate(-50%, 4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .chevron { animation: none; }
  }
</style>
