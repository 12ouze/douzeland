---
// Masthead du site : titre DOUZE LAND + tagline « memoire vive » + nav sobre.
// Le titre est un lien vers la home. La nav surligne (gras + opacité 1) le
// lien correspondant à la page courante.
const pathname = Astro.url.pathname;
const surArchives = pathname === '/archives' || pathname === '/archives/';
---

<header class="masthead">
  <a class="titre" href="/">DOUZE LAND</a>
  <p class="tagline">memoire vive</p>
  <nav class="nav">
    <a href="/archives" class:list={['lien', { actuel: surArchives }]}>archives</a>
  </nav>
</header>

<style>
  .masthead {
    max-width: var(--max-contenu);
    margin: 0 auto;
    padding: 5rem 1.5rem 4rem;
  }

  /* Titre : sans-serif gras, capitales, letter-spacing ample (CLAUDE.md). */
  .titre {
    display: inline-block;
    color: var(--noir);
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    line-height: 1;
  }

  .tagline {
    margin: 0.8rem 0 0;
    color: var(--noir);
    opacity: 0.55;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }

  /* Nav sobre sous la tagline. Lien courant en gras + pleine opacité. */
  .nav {
    margin-top: 1.2rem;
    display: flex;
    gap: 1.5rem;
  }
  .nav .lien {
    color: var(--noir);
    text-decoration: none;
    font-size: 0.8rem;
    text-transform: lowercase;
    letter-spacing: 0.12em;
    opacity: 0.55;
    transition: opacity 0.2s ease;
  }
  .nav .lien:hover { opacity: 1; }
  .nav .lien.actuel {
    opacity: 1;
    font-weight: 700;
  }
</style>
