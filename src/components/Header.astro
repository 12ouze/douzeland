---
// Masthead du site : layout horizontal desktop (identité à gauche, nav à
// droite, alignées sur la ligne de base de « memoire vive »). Mobile (≤600px) :
// passage en vertical (identité puis nav, alignement gauche, pas de burger).
// Nav prête à accueillir d'autres liens (contact, about…) : itération sur
// le tableau `liens` ci-dessous.
// titreEnH1 : posé par la home et /archives, où « DOUZE LAND » est le H1 de
// la page (un seul H1 par page). Les autres pages (contact, 404) gardent le
// lien nu et portent leur propre H1.
const { titreEnH1 = false } = Astro.props;

const pathname = Astro.url.pathname;
const liens = [
  { libelle: 'home', href: '/' },
  { libelle: 'archives', href: '/archives' },
  { libelle: 'contact', href: '/contact' },
  { libelle: 'carnet', href: 'https://carnet.douzeland.com' },
  // À venir : { libelle: 'about', href: '/about' }
];

const estActif = (href) =>
  pathname === href || pathname === href + '/';
---

<header class="masthead">
  <div class="identite">
    {titreEnH1 ? (
      <h1 class="titre-h1"><a class="titre" href="/">DOUZE LAND</a></h1>
    ) : (
      <a class="titre" href="/">DOUZE LAND</a>
    )}
    <p class="tagline">memoire vive</p>
  </div>
  <nav class="nav">
    {liens
      .filter((l) => !(l.href === '/' && estActif('/')))
      .map((l) => (
        <a href={l.href} class:list={['lien', { actuel: estActif(l.href) }]}>{l.libelle}</a>
      ))}
    <!-- futurs liens : about -->
  </nav>
</header>

<style>
  /* Layout horizontal desktop : identité à gauche, nav à droite,
     verticalement centrée par rapport au bloc identité. */
  .masthead {
    max-width: var(--max-contenu);
    margin: 0 auto;
    padding: 5rem 1.5rem 4rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
  }

  /* Enveloppe H1 du titre (home et /archives) : neutralisée pour que le
     rendu soit IDENTIQUE au lien nu — toute la typo vit sur .titre. */
  .titre-h1 {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
    line-height: 1;
  }

  /* Titre : sans-serif gras, capitales, letter-spacing ample (CLAUDE.md). */
  .titre {
    display: inline-block;
    color: var(--noir);
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    line-height: 1;
  }

  .tagline {
    margin: 0.8rem 0 0;
    color: var(--noir);
    opacity: 0.55;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }

  /* Nav : sobre, minuscules. Lien courant en gras + pleine opacité
     (gras choisi plutôt que soulignement — passe mieux si la même nav
     est un jour réutilisée en overlay mix-blend-mode). */
  .nav {
    display: flex;
    gap: 1.5rem;
    flex-shrink: 0;
  }
  .nav .lien {
    color: var(--noir);
    text-decoration: none;
    font-size: 0.85rem;
    text-transform: lowercase;
    letter-spacing: 0.12em;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }
  .nav .lien:hover { opacity: 1; }
  .nav .lien.actuel {
    opacity: 1;
    font-weight: 700;
  }

  /* Mobile (≤600px) : la nav passe sur sa propre ligne, sous « memoire vive »,
     alignée à gauche sur la même marge que le masthead.
     - Avant : titre et nav en `flex-shrink: 0` sur une seule rangée → à 4
       liens, la rangée ne tenait plus sous ~390px et la page défilait
       latéralement (« carnet » coupé au bord). Passer en colonne supprime la
       compétition pour la largeur.
     - `min-width: 0` sur identité et nav : un enfant flex refuse par défaut
       de descendre sous sa largeur de contenu, ce qui est précisément ce qui
       provoquait le débordement.
     - Wrap des liens autorisé : un futur onglet passera à la ligne au lieu
       de recasser le layout.
     - Lien de la page courante masqué (la classe .actuel n'est posée que sur
       0 ou 1 lien selon la page).
     - Titre : wrap naturel laissé par défaut (DOUZE sur une ligne, LAND en
       dessous) — taille héritée du desktop. */
  @media (max-width: 600px) {
    .masthead {
      flex-direction: column;
      align-items: flex-start;
      /* Rythme vertical mobile (mesuré en boîtes DOM à 390px) :
         - les deux paddings sont PARAMÉTRABLES par page via variables CSS,
           avec en fallback les valeurs historiques (5rem au-dessus du
           masthead, 6.5rem avant le contenu). La home et /archives les
           resserrent (3.5rem / 1.5rem) pour que la première photo ne soit
           pas coupée à l'arrivée sur un iPhone ; /contact ne pose rien → il
           garde les fallbacks, strictement inchangé ;
         - gap 1.5rem = 24px entre « memoire vive » et la nav : en dessous
           (testé à 15px) la nav se colle à la baseline de la tagline ;
         - le 1.5rem de padding-bottom posé par home/archives = le gap
           ci-dessus : les trois écarts internes du header (titre → tagline
           ~24px visuels, tagline → nav 24px, nav → contenu 24px) forment une
           cadence régulière (août 2026). L'écart d'entrée passe loin SOUS
           les 96px (6rem) entre deux photos de la galerie : arbitrage
           assumé — le rythme régulier du bloc header + montrer la première
           photo entière (~660px utiles sur iPhone) priment sur la
           hiérarchie « entrée de section > inter-photos ». */
      gap: 1.5rem;
      padding-top: var(--masthead-haut-mobile, 5rem);
      padding-bottom: var(--masthead-bas-mobile, 6.5rem);
    }
    .identite,
    .nav {
      min-width: 0;
      max-width: 100%;
    }
    .nav {
      flex-wrap: wrap;
      flex-shrink: 1;
      row-gap: 0.6rem;
    }
    .nav .lien.actuel {
      display: none;
    }
  }
</style>
