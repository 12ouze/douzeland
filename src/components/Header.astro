---
// Masthead du site : layout horizontal desktop (identité à gauche, nav à
// droite, verticalement centrées). Mobile (≤600px) : passage en vertical
// (identité puis nav, alignement gauche, pas de burger).
// Nav prête à accueillir d'autres liens (contact, about…) : itération sur
// le tableau `liens` ci-dessous.
const pathname = Astro.url.pathname;
const liens = [
  { libelle: 'home', href: '/' },
  { libelle: 'archives', href: '/archives' },
  { libelle: 'contact', href: '/contact' },
  // À venir : { libelle: 'about', href: '/about' }
];

const estActif = (href) =>
  pathname === href || pathname === href + '/';
---

<header class="masthead">
  <div class="identite">
    <a class="titre" href="/">DOUZE LAND</a>
    <p class="tagline">memoire vive</p>
  </div>
  <nav class="nav">
    {liens
      .filter((l) => !(l.href === '/' && estActif('/')))
      .map((l) => (
        <a href={l.href} class:list={['lien', { actuel: estActif(l.href) }]}>{l.libelle}</a>
      ))}
    <!-- futurs liens : about -->
  </nav>
</header>

<style>
  /* Layout horizontal desktop : identité à gauche, nav à droite,
     verticalement centrée par rapport au bloc identité. */
  .masthead {
    max-width: var(--max-contenu);
    margin: 0 auto;
    padding: 5rem 1.5rem 4rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
  }

  /* Titre : sans-serif gras, capitales, letter-spacing ample (CLAUDE.md). */
  .titre {
    display: inline-block;
    color: var(--noir);
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    line-height: 1;
  }

  .tagline {
    margin: 0.8rem 0 0;
    color: var(--noir);
    opacity: 0.55;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }

  /* Nav : sobre, minuscules. Lien courant en gras + pleine opacité
     (gras choisi plutôt que soulignement — passe mieux si la même nav
     est un jour réutilisée en overlay mix-blend-mode). */
  .nav {
    display: flex;
    gap: 1.5rem;
    flex-shrink: 0;
  }
  .nav .lien {
    color: var(--noir);
    text-decoration: none;
    font-size: 0.85rem;
    text-transform: lowercase;
    letter-spacing: 0.12em;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }
  .nav .lien:hover { opacity: 1; }
  .nav .lien.actuel {
    opacity: 1;
    font-weight: 700;
  }

  /* Mobile (≤600px) : on reste en flex horizontal (nav à droite alignée
     avec "memoire vive"). Wrap des liens autorisé si pas la place. */
  @media (max-width: 600px) {
    .nav {
      flex-wrap: wrap;
    }
  }
</style>
